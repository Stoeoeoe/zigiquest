<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash. Keep it visually continuous
         with the animated Flutter splash that follows. -->
    <style name="LaunchTheme" parent="@android:style/Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#F5FDE9</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
    </style>
</resources>
